{
  "name": "Python DevContainer",
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "mounts": [
    "source=devcontainer-python-history-${devcontainerId},target=/commandhistory,type=volume"
  ],
  "containerEnv": {
    "TZ": "${localEnv:TZ:Asia/Tokyo}"
  },
  "postCreateCommand": "make hooks || echo 'コミット前フックを登録できませんでした。原因を直してから make hooks を実行してください。'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "charliermarsh.ruff"
      ],
      "settings": {
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": {
            "path": "/bin/bash"
          }
        }
      }
    }
  },
  "remoteUser": "vscode"
}
