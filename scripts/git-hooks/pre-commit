#!/bin/sh
# devcontainer-python pre-commit hook (managed by `make hooks`; do not edit the
# installed copy in .git/hooks, edit scripts/git-hooks/pre-commit and run
# `make hooks` again).
#
# .git is shared between the Dev Container and the host, so this hook also runs
# for commits made on the host. The pinned tools only exist in the container,
# and a commit must never become impossible because of the hook:
#
# - Inside the Dev Container: run the checks (`prek run`); a failing check
#   stops the commit.
# - Anywhere else: say that the checks are skipped and let the commit through.
#   The same checks run in CI (`make pre-commit`) for every pull request.
#   To run them on the host as well, with tools you installed yourself:
#       git config hooks.devcontainerRunOnHost true
#
# POSIX sh only: on the host this may be dash, the macOS sh or Git for Windows.

# The file that only the image of this repository contains. The variable exists
# for the tests, which cannot remove the file.
marker=${DEVCONTAINER_HOOK_MARKER:-/etc/devcontainer/bashrc}

root=$(git rev-parse --show-toplevel 2>/dev/null) || exit 0

# This file is a copy made by `make hooks`. Say so when the repository has a
# different version (after a pull, or on another branch). It is not replaced
# automatically: that would run code from whatever branch is checked out.
tracked="$root/scripts/git-hooks/pre-commit"
if [ -f "$tracked" ] && ! cmp -s "$tracked" "$0"; then
    cat >&2 <<'MESSAGE'
[pre-commit] 登録されているコミット前フックが、いまのブランチのものと違います。
  更新を取り込んだあとなら、make hooks で登録し直してください。
  内容を信頼できないブランチや、古いブランチでは、実行しないでください（登録されたフックは、どのブランチでも動きます）。
MESSAGE
fi

# Is there a configuration for prek? A branch from before the checks were added
# has nothing to run. One that is tracked but missing from the working tree
# (deleted, or left out by a sparse checkout) cannot be used by prek either:
# say so instead of skipping silently or failing with prek's own error.
configured=0
for name in .pre-commit-config.yaml .pre-commit-config.yml prek.toml; do
    [ -f "$root/$name" ] && configured=1
done
if [ "$configured" -eq 0 ]; then
    if git -C "$root" ls-files -- .pre-commit-config.yaml .pre-commit-config.yml prek.toml 2>/dev/null |
        grep -q .; then
        cat >&2 <<'MESSAGE'
[pre-commit] 検査の設定ファイル（.pre-commit-config.yaml）が作業ツリーにないため、コミット前の検査を省いてコミットします。
  ファイルを戻すと、検査が動きます（git checkout -- .pre-commit-config.yaml）。
MESSAGE
    fi
    exit 0
fi

if [ -r "$marker" ]; then
    where=container
elif [ "$(git config --type=bool --get hooks.devcontainerRunOnHost 2>/dev/null)" = true ]; then
    where=host-opted-in
else
    cat >&2 <<'MESSAGE'
[pre-commit] Dev Container の外（ホスト）なので、コミット前の検査を省いてコミットします。
  検査は、Dev Container 内の make pre-commit か、プルリクエストの CI で行われます。
  コミットは、Dev Container 内で行うことをおすすめします。
MESSAGE
    exit 0
fi

# A commit started with an almost empty environment (some GUI clients, env -i)
# still finds the tools of the image. They go last: PATH keeps its own order.
if [ "$where" = container ]; then
    PATH="${PATH:+$PATH:}/usr/local/bin:/usr/bin:/bin"
    export PATH
fi
if ! command -v prek >/dev/null 2>&1; then
    if [ "$where" = container ]; then
        cat >&2 <<'MESSAGE'
[pre-commit] prek が見つからないため、コミット前の検査を実行できません。
  Dev Container をリビルドしてください（VS Code: Dev Containers: Rebuild Container）。
  今回だけ検査を省く場合は、git commit --no-verify を使ってください。
MESSAGE
        exit 1
    fi
    cat >&2 <<'MESSAGE'
[pre-commit] hooks.devcontainerRunOnHost が有効ですが、prek が見つかりません。検査を省いてコミットします。
MESSAGE
    exit 0
fi

# The image is rebuilt less often than requirements.txt changes. Run the checks
# with what is installed, as before, but say so: results can differ from CI.
lock="$root/requirements.txt"
for tool in prek ruff mypy; do
    # "ruff==0.17.6 \" as pip-compile writes it; stop at anything that is not
    # part of a version (space, backslash, ";", a carriage return).
    want=$(sed -n "s/^$tool==\([0-9][0-9A-Za-z.+!*-]*\).*/\1/p" "$lock" 2>/dev/null | head -n 1)
    command -v "$tool" >/dev/null 2>&1 || continue
    # "ruff 0.17.6", "mypy 2.4.1 (compiled: yes)": only a line that starts
    # with the tool's name counts, not a warning printed before it.
    have=$("$tool" --version 2>/dev/null | sed -n "s/^$tool \([0-9][^ ]*\).*/\1/p" | head -n 1)
    if [ -n "$want" ] && [ -n "$have" ] && [ "$have" != "$want" ]; then
        # "0.17.*" is a range, not a version to compare with.
        case $want in *'*'*) continue ;; esac
        printf '[pre-commit] %s の版が requirements.txt と違います（必要: %s、実際: %s）。検査の結果が CI と変わることがあります。\n' \
            "$tool" "$want" "$have" >&2
        [ "$where" = container ] &&
            printf '  Dev Container をリビルドすると、版が揃います。\n' >&2
    fi
done

cd "$root" || exit 0
exec prek run
